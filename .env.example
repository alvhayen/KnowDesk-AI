# ==============================================================================
# KnowDesk AI — Environment Configuration Example (.env.example)
# Salin berkas ini ke .env dan isi nilai yang sesuai.
# PERINGATAN (Aturan R2): JANGAN PERNAH meng-commit berkas .env ke repositori Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenRouter API & LLM Models
# ------------------------------------------------------------------------------
# Kunci API OpenRouter (didapatkan dari https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Chat (dipilih oleh pengguna, contoh: meta-llama/llama-3.1-8b-instruct)
CHAT_MODEL=meta-llama/llama-3.1-8b-instruct

# Model Embedding (contoh: openai/text-embedding-3-small)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Parameter Generasi LLM
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_TIMEOUT_S=30.0
TOOL_TIMEOUT_S=5.0

# ------------------------------------------------------------------------------
# Agent Execution Limits
# ------------------------------------------------------------------------------
# Batas langkah solusi per sesi sebelum eskalasi ke tiket
AGENT_MAX_STEPS=4

# Batas pertanyaan klarifikasi per sesi
AGENT_MAX_CLARIFICATIONS=2

# Penjaga biaya: batas maksimum pemanggilan LLM dalam satu giliran chat
AGENT_MAX_LLM_CALLS_PER_TURN=3

# ------------------------------------------------------------------------------
# RAG (Retrieval-Augmented Generation)
# ------------------------------------------------------------------------------
# Ambang batas cosine similarity minimal gerbang retrieval (K1)
RAG_MIN_COSINE=0.35

# Batas cosine similarity untuk keyakinan kategori 'tinggi'
RAG_HIGH_COSINE=0.55

# Konstanta k untuk Reciprocal Rank Fusion (RRF)
RAG_RRF_K=60

# Jumlah dokumen/chunk relevan maksimum yang dikembalikan
RAG_MAX_RESULTS=5

# Overlap kata antar bagian dokumen (chunking)
RAG_CHUNK_OVERLAP=50

# ------------------------------------------------------------------------------
# Guardrails
# ------------------------------------------------------------------------------
# Batas panjang karakter masukan pengguna (Lapis 1 Input Guard)
INPUT_MAX_CHARS=1000

# ------------------------------------------------------------------------------
# MySQL Database
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=knowdesk_app
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=knowdesk_ai

# ------------------------------------------------------------------------------
# Application & Server
# ------------------------------------------------------------------------------
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
